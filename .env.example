# Public Development Intelligence Platform - Environment Variables

# Server Configuration
PORT=8080
ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Google AI / Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
EMBEDDING_MODEL=gemini-embedding-001

# Google Cloud / Firebase Firestore
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
FIRESTORE_EMULATOR_HOST=

# viasocket Integration (GDG Sponsor)
VIASOCKET_WEBHOOK_SECRET=your_viasocket_webhook_secret_here

# Telegram Bot API
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here

# Twilio WhatsApp (Track 4 — citizen channel)
# Account SID is an identifier, not a secret. The auth token IS a secret:
# without it the platform simply does not send WhatsApp replies.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
