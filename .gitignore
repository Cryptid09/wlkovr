# Environment & Secrets — never commit real keys.
# Copy .env.example to .env and fill it in locally.
.env
.env.*
.env*.local
!.env.example

# Service account keys — put downloaded Firebase/GCP JSON credentials in .secrets/
.secrets/
*-sa.json
*serviceAccount*.json
*-credentials.json
*firebase-adminsdk*.json

# Local persistence / scratch storage
# Regenerate with: cd server && go run ./cmd/seed --reset
server/data/local_store/
server/data/local_store.backup-*/
server/bin/

# Dependencies & Build artifacts
node_modules/
web/node_modules/
web/.next/
web/out/
*.test

# System & Logs
.DS_Store
*.log

# Test artifact: server/tests/reporter_test.go writes a report to a hardcoded
# Windows path, which becomes a literal filename on macOS/Linux.
server/tests/C:*

# Compiled Go binaries left by `go build ./cmd/<name>` run from server/
server/seed
server/api
server/recluster
server/tunnel-gateway
