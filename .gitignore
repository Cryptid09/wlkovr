# Secrets — never commit real keys. Copy .env.example to .env and fill it in locally.
.env
.env.*
!.env.example

# Service account keys — put downloaded Firebase/GCP JSON credentials in here
.secrets/
*serviceAccount*.json
*-credentials.json

# Seeded data store — regenerate with: cd server && go run ./cmd/seed --reset
server/data/local_store/

# Go build output
server/bin/
*.test

# Node / Next.js
node_modules/
web/.next/
web/out/

# OS
.DS_Store
