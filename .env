# Public Development Intelligence Platform - Environment Variables

# Server Configuration
PORT=8080
ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Google AI / Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004

# Google Cloud / Firebase Firestore
GOOGLE_CLOUD_PROJECT=zen-dev-intelligence
FIRESTORE_EMULATOR_HOST=

# viasocket Integration (GDG Sponsor)
VIASOCKET_WEBHOOK_SECRET=zen-secret-key-12345

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
